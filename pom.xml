<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.michibaum</groupId>
    <artifactId>kwswitcher</artifactId>
    <version>1.2.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>kwswitcher</name>
    <description>Lightweight keyboard-driven Windows switcher using Kotlin, Swing/FlatLaf, and JDK 25 Panama FFM</description>

    <modules>
        <module>kwswitcher-core</module>
        <module>kwswitcher-win32</module>
        <module>kwswitcher-app</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <kotlin.compiler.jvmTarget>25</kotlin.compiler.jvmTarget>
        <maven.compiler.release>25</maven.compiler.release>
        <detekt.skip>false</detekt.skip>
        <gitflow.mvnExecutable>${project.basedir}/mvnw</gitflow.mvnExecutable>
        <kwswitcher.root.dir>${project.basedir}</kwswitcher.root.dir>
        <argLine></argLine>
        <main.class>com.michibaum.kwswitcher.app.MainKt</main.class>
        <kwswitcher.mode></kwswitcher.mode>
        <kwswitcher.noHook>false</kwswitcher.noHook>
        <kwswitcher.pinOverlay>false</kwswitcher.pinOverlay>
        <kwswitcher.openOnStart></kwswitcher.openOnStart>
        <kwswitcher.config></kwswitcher.config>
        <kwswitcher.logLevel></kwswitcher.logLevel>
        <kwswitcher.selfCheck>false</kwswitcher.selfCheck>

        <!-- Dependencies -->
        <!-- https://central.sonatype.com/artifact/org.jetbrains.kotlin/kotlin-stdlib -->
        <kotlin.version>2.4.21</kotlin.version>
        <!-- https://central.sonatype.com/artifact/org.jetbrains.kotlinx/kotlinx-coroutines-core -->
        <coroutines.version>1.11.0</coroutines.version>
        <serialization.version>1.13.0</serialization.version>
        <kotlin.logging.version>8.0.7</kotlin.logging.version>
        <slf4j.version>2.0.20</slf4j.version>
        <!-- https://central.sonatype.com/artifact/com.formdev/flatlaf -->
        <flatlaf.version>3.8</flatlaf.version>
        <!-- https://central.sonatype.com/artifact/org.junit.jupiter/junit-jupiter -->
        <junit.version>6.1.3</junit.version>
        <kover.version>0.9.8</kover.version>
        <detekt.version>2.0.0-alpha.6</detekt.version>
        <spotless.version>3.12.0</spotless.version>
        <ktlint.version>1.8.0</ktlint.version>
        <gitflow.version>1.21.0</gitflow.version>

        <!-- Plugins -->
        <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-surefire-plugin -->
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
        <!-- https://central.sonatype.com/artifact/org.codehaus.mojo/exec-maven-plugin -->
        <exec-maven-plugin.version>3.7.0</exec-maven-plugin.version>
        <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-dependency-plugin -->
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
        <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-jar-plugin -->
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-assembly-plugin -->
        <maven-assembly-plugin.version>3.8.0</maven-assembly-plugin.version>
        <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-resources-plugin -->
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-antrun-plugin -->
        <maven-antrun-plugin.version>3.2.0</maven-antrun-plugin.version>

        <!-- JDK 25 + Tuned G1GC flags shared by exec:exec and jpackage -->
        <jvm.flag.nativeAccess>--enable-native-access=ALL-UNNAMED</jvm.flag.nativeAccess>
        <jvm.flag.compactHeaders>-XX:+UseCompactObjectHeaders</jvm.flag.compactHeaders>
        <jvm.flag.gc>-XX:+UseG1GC</jvm.flag.gc>
        <jvm.flag.xms>-Xms16m</jvm.flag.xms>
        <jvm.flag.xmx>-Xmx96m</jvm.flag.xmx>
        <jvm.flag.maxPause>-XX:MaxGCPauseMillis=10</jvm.flag.maxPause>
        <jvm.flag.minFree>-XX:MinHeapFreeRatio=10</jvm.flag.minFree>
        <jvm.flag.maxFree>-XX:MaxHeapFreeRatio=30</jvm.flag.maxFree>

        <!-- jpackage metadata & trimmed runtime configuration -->
        <jpackage.vendor>michibaum</jpackage.vendor>
        <jpackage.icon>${kwswitcher.root.dir}/kwswitcher-core/src/main/resources/icons/kwswitcher.ico</jpackage.icon>
        <jpackage.modules>java.base,java.desktop</jpackage.modules>
        <jpackage.jlinkOptions>--strip-native-commands --strip-debug --no-man-pages --no-header-files --compress=zip-6</jpackage.jlinkOptions>
        <jpackage.win.upgradeUuid>8f4c2e91-5b7a-4d3e-9c12-6a0f8e4d2b19</jpackage.win.upgradeUuid>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib</artifactId>
                <version>${kotlin.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlinx</groupId>
                <artifactId>kotlinx-coroutines-core</artifactId>
                <version>${coroutines.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlinx</groupId>
                <artifactId>kotlinx-coroutines-swing</artifactId>
                <version>${coroutines.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlinx</groupId>
                <artifactId>kotlinx-serialization-json</artifactId>
                <version>${serialization.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.oshai</groupId>
                <artifactId>kotlin-logging-jvm</artifactId>
                <version>${kotlin.logging.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>com.formdev</groupId>
                <artifactId>flatlaf</artifactId>
                <version>${flatlaf.version}</version>
            </dependency>

            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-test-junit5</artifactId>
                <version>${kotlin.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlinx</groupId>
                <artifactId>kotlinx-coroutines-test</artifactId>
                <version>${coroutines.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>3.6.0</version>
                    <executions>
                        <execution>
                            <id>parse-version</id>
                            <phase>validate</phase>
                            <goals>
                                <goal>parse-version</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>set-jpackage-app-version</id>
                            <phase>validate</phase>
                            <goals>
                                <goal>regex-property</goal>
                            </goals>
                            <configuration>
                                <name>jpackage.appVersion</name>
                                <value>${parsedVersion.majorVersion}.${parsedVersion.minorVersion}.${parsedVersion.incrementalVersion}</value>
                                <regex>-.*</regex>
                                <replacement/>
                                <failIfNoMatch>false</failIfNoMatch>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                </plugin>

                <plugin>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-maven-plugin</artifactId>
                    <version>${kotlin.version}</version>
                    <executions>
                        <execution>
                            <id>compile</id>
                            <goals>
                                <goal>compile</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>test-compile</id>
                            <goals>
                                <goal>test-compile</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <jvmTarget>${kotlin.compiler.jvmTarget}</jvmTarget>
                        <compilerPlugins>
                            <plugin>kotlinx-serialization</plugin>
                        </compilerPlugins>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>org.jetbrains.kotlin</groupId>
                            <artifactId>kotlin-maven-serialization</artifactId>
                            <version>${kotlin.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <argLine>@{argLine}</argLine>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.jetbrains.kotlinx</groupId>
                    <artifactId>kover-maven-plugin</artifactId>
                    <version>${kover.version}</version>
                    <executions>
                        <execution>
                            <id>kover-instrumentation</id>
                            <goals>
                                <goal>instrumentation</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>kover-report</id>
                            <goals>
                                <goal>report-xml</goal>
                                <goal>report-html</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-maven-plugin.version}</version>
                    <configuration>
                        <executable>java</executable>
                        <skip>true</skip>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>${maven-assembly-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.version}</version>
                    <configuration>
                        <kotlin>
                            <includes>
                                <include>src/main/kotlin/**/*.kt</include>
                                <include>src/test/kotlin/**/*.kt</include>
                            </includes>
                            <ktlint>
                                <version>${ktlint.version}</version>
                            </ktlint>
                        </kotlin>
                    </configuration>
                    <executions>
                        <execution>
                            <id>spotless-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>${maven-antrun-plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>dev.detekt</groupId>
                            <artifactId>detekt-cli</artifactId>
                            <version>${detekt.version}</version>
                        </dependency>
                    </dependencies>
                    <executions>
                        <execution>
                            <id>detekt</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>run</goal>
                            </goals>
                            <configuration>
                                <skip>${detekt.skip}</skip>
                                <target>
                                    <mkdir dir="${project.basedir}/src/main/kotlin"/>
                                    <mkdir dir="${project.basedir}/src/test/kotlin"/>
                                    <mkdir dir="${project.build.directory}/detekt"/>
                                    <java classname="dev.detekt.cli.Main"
                                          fork="true"
                                          failonerror="true">
                                        <classpath refid="maven.plugin.classpath"/>
                                        <arg value="--input"/>
                                        <arg value="${project.basedir}/src/main/kotlin${path.separator}${project.basedir}/src/test/kotlin"/>
                                        <arg value="--config"/>
                                        <arg value="${kwswitcher.root.dir}/config/detekt/detekt.yml"/>
                                        <arg value="--build-upon-default-config"/>
                                        <arg value="--jvm-target"/>
                                        <arg value="${kotlin.compiler.jvmTarget}"/>
                                        <arg value="--parallel"/>
                                        <arg value="--base-path"/>
                                        <arg value="${kwswitcher.root.dir}"/>
                                        <arg value="--report"/>
                                        <arg value="html:${project.build.directory}/detekt/detekt.html"/>
                                        <arg value="--report"/>
                                        <arg value="sarif:${project.build.directory}/detekt/detekt.sarif"/>
                                    </java>
                                </target>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>com.amashchenko.maven.plugin</groupId>
                    <artifactId>gitflow-maven-plugin</artifactId>
                    <version>${gitflow.version}</version>
                    <configuration>
                        <mvnExecutable>${gitflow.mvnExecutable}</mvnExecutable>
                        <skipFeatureVersion>true</skipFeatureVersion>
                        <skipTestProject>true</skipTestProject>
                        <preFeatureFinishGoals>verify</preFeatureFinishGoals>
                        <preReleaseGoals>verify</preReleaseGoals>
                        <preHotfixGoals>verify</preHotfixGoals>
                        <digitsOnlyDevVersion>false</digitsOnlyDevVersion>
                        <gitFlowConfig>
                            <productionBranch>main</productionBranch>
                            <developmentBranch>develop</developmentBranch>
                            <featureBranchPrefix>feature/</featureBranchPrefix>
                            <releaseBranchPrefix>release/</releaseBranchPrefix>
                            <hotfixBranchPrefix>hotfix/</hotfixBranchPrefix>
                            <supportBranchPrefix>support/</supportBranchPrefix>
                            <origin>origin</origin>
                        </gitFlowConfig>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>detekt</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-cli</id>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${detekt.skip}</skip>
                            <target>
                                <mkdir dir="${project.basedir}/kwswitcher-core/src/main/kotlin"/>
                                <mkdir dir="${project.basedir}/kwswitcher-core/src/test/kotlin"/>
                                <mkdir dir="${project.basedir}/kwswitcher-win32/src/main/kotlin"/>
                                <mkdir dir="${project.basedir}/kwswitcher-win32/src/test/kotlin"/>
                                <mkdir dir="${project.basedir}/kwswitcher-app/src/main/kotlin"/>
                                <mkdir dir="${project.basedir}/kwswitcher-app/src/test/kotlin"/>
                                <mkdir dir="${project.build.directory}/detekt"/>
                                <java classname="dev.detekt.cli.Main"
                                      fork="true"
                                      failonerror="true">
                                    <classpath refid="maven.plugin.classpath"/>
                                    <arg value="--input"/>
                                    <arg value="${project.basedir}/kwswitcher-core/src/main/kotlin${path.separator}${project.basedir}/kwswitcher-core/src/test/kotlin${path.separator}${project.basedir}/kwswitcher-win32/src/main/kotlin${path.separator}${project.basedir}/kwswitcher-win32/src/test/kotlin${path.separator}${project.basedir}/kwswitcher-app/src/main/kotlin${path.separator}${project.basedir}/kwswitcher-app/src/test/kotlin"/>
                                    <arg value="--config"/>
                                    <arg value="${project.basedir}/config/detekt/detekt.yml"/>
                                    <arg value="--build-upon-default-config"/>
                                    <arg value="--jvm-target"/>
                                    <arg value="${kotlin.compiler.jvmTarget}"/>
                                    <arg value="--parallel"/>
                                    <arg value="--base-path"/>
                                    <arg value="${project.basedir}"/>
                                    <arg value="--report"/>
                                    <arg value="html:${project.build.directory}/detekt/detekt.html"/>
                                    <arg value="--report"/>
                                    <arg value="sarif:${project.build.directory}/detekt/detekt.sarif"/>
                                </java>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>com.amashchenko.maven.plugin</groupId>
                <artifactId>gitflow-maven-plugin</artifactId>
                <inherited>false</inherited>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>windows-mvnw</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <gitflow.mvnExecutable>${project.basedir}\mvnw.cmd</gitflow.mvnExecutable>
            </properties>
        </profile>
        <profile>
            <id>jpackage</id>
        </profile>
        <profile>
            <id>jpackage-installer</id>
        </profile>
    </profiles>
</project>
