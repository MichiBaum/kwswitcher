       title="Kotlin Switcheroo (%cmd_name%)" id="overview">

    <section-starting-page>
        <title>%product% (%cmd_name%)</title>
        <description>
            A lightweight, keyboard-driven window switcher for Windows 10 and Windows 11 built with Kotlin (JDK %jdk_version%),
            Swing + FlatLaf, and the Project Panama Foreign Function and Memory API. Switch, search, minimize, close, or
            terminate open windows in under 20 ms without touching the mouse.
        </description>

        <spotlight>
            <a href="installation.md" type="install"
               summary="Install via MSI, run the portable native bundle, or launch the executable fat JAR and enable Windows startup.">Get Started and Install</a>
            <a href="usage-and-shortcuts.md" type="keyboard"
               summary="Master Quick-Switch vs. Interactive Search modes, keyboard shortcuts, in-place window actions, and tray controls."/>
        </spotlight>

        <primary>
            <title>User Guide</title>
            <a href="installation.md"
               summary="System requirements, installation options, single-instance protection, and logon startup setup."/>
            <a href="usage-and-shortcuts.md"
               summary="Alt+Tab cycling, interactive search locking, window close/minimize/kill actions, and visual badges."/>
            <a href="search-and-filtering.md"
               summary="How multi-token fuzzy search ranks prefixes, word boundaries, acronyms, substrings, and subsequences."/>
            <a href="configuration.md"
               summary="Customize global hotkeys, themes, badges, and process or title ignore rules in config.json."/>
        </primary>

        <secondary>
            <title>Developer Guide</title>
            <a href="architecture.md"
               summary="Design goals, latency and memory budgets, the 3-thread execution model, and state machine transitions."/>
            <a href="win32-panama-ffm.md"
               summary="JDK 25 java.lang.foreign Win32 bindings, arena lifetimes, hung-window timeouts, foreground-lock bypass, and UIPI."/>
            <a href="building-and-releasing.md"
               summary="Maven test, run, and jpackage profiles, Writerside documentation authoring, and GitHub Actions CI/CD."/>
        </secondary>

        <misc>
