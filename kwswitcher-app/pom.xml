<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.michibaum</groupId>
        <artifactId>kwswitcher</artifactId>
        <version>1.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>kwswitcher-app</artifactId>
    <packaging>jar</packaging>
    <name>kwswitcher-app</name>
    <description>Application composition root, CLI modes, SLF4J diagnostics provider, and native jpackage bundles</description>

    <properties>
        <kwswitcher.root.dir>${project.basedir}/..</kwswitcher.root.dir>
        <jpackage.icon>${project.basedir}/../kwswitcher-core/src/main/resources/icons/kwswitcher.ico</jpackage.icon>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.michibaum</groupId>
            <artifactId>kwswitcher-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.michibaum</groupId>
            <artifactId>kwswitcher-win32</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-swing</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.oshai</groupId>
            <artifactId>kotlin-logging-jvm</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
        </dependency>

        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>kwswitcher-${project.version}</finalName>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>clean-jpackage-staging</id>
                            <phase>prepare-package</phase>
                            <goals>
                                <goal>run</goal>
                            </goals>
                            <configuration>
                                <target>
                                    <delete dir="${project.build.directory}/jpackage-input"/>
                                    <delete dir="${project.build.directory}/app-image"/>
                                    <delete dir="${project.build.directory}/dist"/>
                                </target>
                            </configuration>
                        </execution>
                        <execution>
                            <id>jpackage-app-image</id>
                            <phase>package</phase>
                            <goals>
                                <goal>run</goal>
                            </goals>
                            <configuration>
                                <target>
                                    <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                          todir="${project.build.directory}/jpackage-input"/>
                                    <exec executable="jpackage" failonerror="true">
                                        <arg value="--type"/>
                                        <arg value="app-image"/>
                                        <arg value="--name"/>
                                        <arg value="kwswitcher"/>
                                        <arg value="--vendor"/>
                                        <arg value="${jpackage.vendor}"/>
                                        <arg value="--app-version"/>
                                        <arg value="${jpackage.appVersion}"/>
                                        <arg value="--icon"/>
                                        <arg value="${jpackage.icon}"/>
                                        <arg value="--input"/>
                                        <arg value="${project.build.directory}/jpackage-input"/>
                                        <arg value="--main-jar"/>
                                        <arg value="${project.build.finalName}.jar"/>
                                        <arg value="--main-class"/>
                                        <arg value="${main.class}"/>
                                        <arg value="--dest"/>
                                        <arg value="${project.build.directory}/app-image"/>
                                        <arg value="--add-modules"/>
                                        <arg value="${jpackage.modules}"/>
                                        <arg value="--jlink-options"/>
                                        <arg value="${jpackage.jlinkOptions}"/>
                                        <arg value="--java-options"/>
                                        <arg value="${jvm.flag.nativeAccess}"/>
                                        <arg value="--java-options"/>
                                        <arg value="${jvm.flag.compactHeaders}"/>
                                        <arg value="--java-options"/>
                                        <arg value="${jvm.flag.gc}"/>
                                        <arg value="--java-options"/>
                                        <arg value="${jvm.flag.xms}"/>
                                        <arg value="--java-options"/>
                                        <arg value="${jvm.flag.xmx}"/>
                                        <arg value="--java-options"/>
                                        <arg value="${jvm.flag.maxPause}"/>
                                        <arg value="--java-options"/>
                                        <arg value="${jvm.flag.minFree}"/>
                                        <arg value="--java-options"/>
                                        <arg value="${jvm.flag.maxFree}"/>
                                    </exec>
                                </target>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>copy-jpackage-dependencies</id>
                            <phase>prepare-package</phase>
                            <goals>
                                <goal>copy-dependencies</goal>
                            </goals>
                            <configuration>
                                <outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
                                <includeScope>runtime</includeScope>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} ${jvm.flag.nativeAccess}</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jetbrains.kotlinx</groupId>
                <artifactId>kover-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <executable>java</executable>
                    <arguments>
                        <argument>${jvm.flag.nativeAccess}</argument>
                        <argument>${jvm.flag.compactHeaders}</argument>
                        <argument>${jvm.flag.gc}</argument>
                        <argument>${jvm.flag.xms}</argument>
                        <argument>${jvm.flag.xmx}</argument>
                        <argument>${jvm.flag.maxPause}</argument>
                        <argument>${jvm.flag.minFree}</argument>
                        <argument>${jvm.flag.maxFree}</argument>
                        <argument>-Dkwswitcher.mode=${kwswitcher.mode}</argument>
                        <argument>-Dkwswitcher.noHook=${kwswitcher.noHook}</argument>
                        <argument>-Dkwswitcher.pinOverlay=${kwswitcher.pinOverlay}</argument>
                        <argument>-Dkwswitcher.openOnStart=${kwswitcher.openOnStart}</argument>
                        <argument>-Dkwswitcher.config=${kwswitcher.config}</argument>
                        <argument>-Dkwswitcher.logLevel=${kwswitcher.logLevel}</argument>
                        <argument>-Dkwswitcher.selfCheck=${kwswitcher.selfCheck}</argument>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>${main.class}</argument>
                    </arguments>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                        </manifest>
                        <manifestEntries>
                            <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                        </manifest>
                        <manifestEntries>
                            <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                        </manifestEntries>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>clean-jpackage-staging</id>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jpackage-app-image</id>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>jpackage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>clean-jpackage-staging</id>
                                <configuration>
                                    <skip>false</skip>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jpackage-app-image</id>
                                <configuration>
                                    <skip>false</skip>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>jpackage-installer</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>clean-jpackage-staging</id>
                                <configuration>
                                    <skip>false</skip>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jpackage-app-image</id>
                                <configuration>
                                    <skip>false</skip>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jpackage-msi</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <exec executable="jpackage" failonerror="true">
                                            <arg value="--type"/>
                                            <arg value="msi"/>
                                            <arg value="--name"/>
                                            <arg value="kwswitcher"/>
                                            <arg value="--vendor"/>
                                            <arg value="${jpackage.vendor}"/>
                                            <arg value="--app-version"/>
                                            <arg value="${jpackage.appVersion}"/>
                                            <arg value="--icon"/>
                                            <arg value="${jpackage.icon}"/>
                                            <arg value="--app-image"/>
                                            <arg value="${project.build.directory}/app-image/kwswitcher"/>
                                            <arg value="--dest"/>
                                            <arg value="${project.build.directory}/dist"/>
                                            <arg value="--win-upgrade-uuid"/>
                                            <arg value="${jpackage.win.upgradeUuid}"/>
                                            <arg value="--win-dir-chooser"/>
                                            <arg value="--win-menu"/>
                                            <arg value="--win-shortcut"/>
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
